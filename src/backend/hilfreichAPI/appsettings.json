{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "FileLogger": {
      "Options": {
        "FolderPath": "logs",
        "FilePath": "log_{date}.log"
      },
      "LogLevel": {
        "Default": "Error",
        "Microsoft.AspNetCore": "Error",
        "hilfreichAPI.Controllers": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}
